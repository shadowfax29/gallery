{
  "name": "adgallery-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "nodemon backend/server.js",
    "dev": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.8.30",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  },
  "dependencies": {
    "@types/three": "^0.181.0",
    "axios": "^1.12.2",
    "selenium-webdriver": "^4.35.0",
    "three": "^0.181.2",
    "web-vitals": "^5.1.0"
  }
}
